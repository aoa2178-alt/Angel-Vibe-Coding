# Copy to .env.local for local development. Never commit .env.local.

# Claude API key used by the server. Leave empty to paste a key into the page instead.
ANTHROPIC_API_KEY=

# Shared code teammates enter to use the tool. Required on Vercel; optional locally.
TEAM_ACCESS_CODE=

# Set automatically on Vercel when a private Blob store is connected to the project.
# Leave unset locally: development then stores profiles in data/profiles.json.
BLOB_STORE_ID=
