# Copy to .env.local for local development. Never commit .env.local.

# Claude API key used by the server. Leave empty to paste a key into the page instead.
ANTHROPIC_API_KEY=

# Shared code teammates enter to use the tool. Required on Vercel; optional locally.
TEAM_ACCESS_CODE=

# Set automatically when you add Upstash Redis from the Vercel Marketplace (vercel install upstash).
# Without these, local development stores profiles in data/profiles.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
